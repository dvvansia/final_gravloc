    <script>
      // Testimonial Auto-Slide with Arrows & Swipe Support
      (function () {
        const slider = document.getElementById("testimonial-slider");
        const dots = document.querySelectorAll("[data-index]");
        const prevBtn = document.getElementById("testimonial-prev");
        const nextBtn = document.getElementById("testimonial-next");
        let currentIndex = 0;
        const totalSlides = 2;
        let interval;
        let startX = 0;
        let isDragging = false;

        function goToSlide(index) {
          if (index < 0) index = totalSlides - 1;
          if (index >= totalSlides) index = 0;
          currentIndex = index;
          slider.style.transform = "translateX(-" + index * 100 + "%)";

          // Update dots
          dots.forEach((dot, i) => {
            if (i === index) {
              dot.classList.remove("bg-outline-variant/50");
              dot.classList.add("bg-accent-cyan");
            } else {
              dot.classList.remove("bg-accent-cyan");
              dot.classList.add("bg-outline-variant/50");
            }
          });
        }

        function nextSlide() {
          goToSlide(currentIndex + 1);
        }

        function prevSlide() {
          goToSlide(currentIndex - 1);
        }

        function startAutoSlide() {
          stopAutoSlide();
          interval = setInterval(nextSlide, 6000);
        }

        function stopAutoSlide() {
          clearInterval(interval);
        }

        // Arrow buttons
        if (prevBtn) {
          prevBtn.addEventListener("click", function (e) {
            e.stopPropagation();
            stopAutoSlide();
            prevSlide();
            startAutoSlide();
          });
        }

        if (nextBtn) {
          nextBtn.addEventListener("click", function (e) {
            e.stopPropagation();
            stopAutoSlide();
            nextSlide();
            startAutoSlide();
          });
        }

        // Dot indicators
        dots.forEach((dot) => {
          dot.addEventListener("click", function () {
            const index = parseInt(this.getAttribute("data-index"));
            stopAutoSlide();
            goToSlide(index);
            startAutoSlide();
          });
        });

        // Touch swipe support (mobile)
        const container = slider.parentElement;

        container.addEventListener(
          "touchstart",
          function (e) {
            startX = e.touches[0].clientX;
            isDragging = true;
            stopAutoSlide();
          },
          { passive: true },
        );

        container.addEventListener(
          "touchmove",
          function (e) {
            if (!isDragging) return;
            // Just track movement, we'll decide on touchend
          },
          { passive: true },
        );

        container.addEventListener(
          "touchend",
          function (e) {
            if (!isDragging) return;
            isDragging = false;
            const endX = e.changedTouches[0].clientX;
            const diff = startX - endX;

            // Swipe threshold: 50px
            if (Math.abs(diff) > 50) {
              if (diff > 0) {
                nextSlide();
              } else {
                prevSlide();
              }
            }
            startAutoSlide();
          },
          { passive: true },
        );

        // Mouse drag support (desktop)
        let mouseStartX = 0;
        let isMouseDown = false;

        container.addEventListener("mousedown", function (e) {
          mouseStartX = e.clientX;
          isMouseDown = true;
          stopAutoSlide();
          container.style.cursor = "grabbing";
        });

        container.addEventListener("mousemove", function (e) {
          if (!isMouseDown) return;
        });

        container.addEventListener("mouseup", function (e) {
          if (!isMouseDown) return;
          isMouseDown = false;
          container.style.cursor = "grab";
          const endX = e.clientX;
          const diff = mouseStartX - endX;

          if (Math.abs(diff) > 50) {
            if (diff > 0) {
              nextSlide();
            } else {
              prevSlide();
            }
          }
          startAutoSlide();
        });

        container.addEventListener("mouseleave", function () {
          if (isMouseDown) {
            isMouseDown = false;
            container.style.cursor = "grab";
            startAutoSlide();
          }
        });

        // Pause on hover (desktop)
        container.addEventListener("mouseenter", stopAutoSlide);
        container.addEventListener("mouseleave", startAutoSlide);

        // Initial state
        goToSlide(0);
        startAutoSlide();
      })();
    </script>
  </body>
</html>
