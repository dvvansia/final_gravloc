      function switchTab(index) {
        const container = document.getElementById("tab-content");
        const btns = document.querySelectorAll(".tab-btn");

        // Update buttons
        btns.forEach((btn, i) => {
          if (i === index) {
            btn.classList.add("bg-primary-container", "text-white");
            btn.classList.remove(
              "border-outline-variant",
              "text-on-surface-variant",
            );
          } else {
            btn.classList.remove("bg-primary-container", "text-white");
            btn.classList.add(
              "border-outline-variant",
              "text-on-surface-variant",
            );
          }
        });

        // Update content
        const data = tabData[index];
        container.innerHTML = `
                <div class="tab-pane space-y-6 opacity-0 translate-y-2 transition-all duration-300" id="current-pane">
                    <span class="font-label-mono text-accent-cyan uppercase tracking-tighter">${data.tag}</span>
                    <h3 class="font-headline-lg text-headline-lg">${data.title}</h3>
                    <p class="text-body-md text-on-surface-variant leading-relaxed">${data.desc}</p>
                    <ul class="space-y-3">
                        ${data.bullets
                          .map(
                            (b) => `
                            <li class="flex items-center gap-3 text-body-sm text-on-surface">
                                <span class="material-symbols-outlined text-accent-cyan">check_circle</span>
                                ${b}
                            </li>
                        `,
                          )
                          .join("")}
                    </ul>
                </div>
            `;

        setTimeout(() => {
          document
            .getElementById("current-pane")
            .classList.remove("opacity-0", "translate-y-2");
        }, 10);
      }
