    <script>
      // Mobile menu toggle
      const menuBtn = document.getElementById("mobile-menu-btn");
      const mobileMenu = document.getElementById("mobile-menu");
      if (menuBtn && mobileMenu) {
        menuBtn.addEventListener("click", function (e) {
          e.preventDefault();
          const isOpen = !mobileMenu.classList.contains("hidden");
          mobileMenu.classList.toggle("hidden");
          this.setAttribute("aria-expanded", String(!isOpen));
          const icon = this.querySelector(".material-symbols-outlined");
          if (icon) {
            icon.textContent = isOpen ? "menu" : "close";
          }
        });
      }
    </script>
    <script>
      // Waitlist form - sends data to our own backend (/api/supplier-waitlist),
      // which writes to a dedicated supplier_waitlist table in Postgres
      const notifyForm = document.getElementById("notify-form");
      if (notifyForm) {
        notifyForm.addEventListener("submit", function (e) {
          e.preventDefault();

          const btn = document.getElementById("notify-btn");
          const input = document.getElementById("notify-email");
          const email = input.value.trim();

          if (!email) {
            alert("Please enter a valid email address.");
            return;
          }

          // Disable button and show loading state
          btn.textContent = "Submitting...";
          btn.disabled = true;

          // Same-origin request to our Express route — no CORS issues since this
          // is served from the same app, so we get a real, readable JSON response.
          fetch("/api/supplier-waitlist", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email }),
          })
            .then((response) =>
              response.json().then((data) => ({ ok: response.ok, data })),
            )
            .then(({ ok, data }) => {
              if (ok && data.success) {
                btn.textContent = "You're on the list! 🚀";
                btn.classList.add("opacity-70");
                input.value = "";
              } else {
                // Covers duplicate email and validation errors alike —
                // the backend returns success: false with a message either way.
                alert(
                  data.message || "Something went wrong. Please try again.",
                );
                btn.textContent = "Notify Me";
                btn.disabled = false;
              }
            })
            .catch((error) => {
              console.error("Error:", error);
              alert("Something went wrong. Please try again.");
              btn.textContent = "Notify Me";
              btn.disabled = false;
            });
        });
      }
    </script>
